# ============================================================
# Ce template est destiné au déploiement Fly.io.
# Pour Fly.io, NE PAS créer un .env.production : utiliser
#   fly secrets set KEY="value" ...
# à la place. Ce fichier sert uniquement de référence pour les
# noms de variables attendues par Strapi en production.
# Voir DEPLOYMENT_FREE.md pour la procédure complète.
# ============================================================

HOST=0.0.0.0
PORT=1337
APP_KEYS=<generate-4-base64-keys-separated-by-commas>
API_TOKEN_SALT=<generate-base64>
ADMIN_JWT_SECRET=<generate-base64>
TRANSFER_TOKEN_SALT=<generate-base64>
JWT_SECRET=<generate-base64>
DATABASE_CLIENT=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=medicare
DATABASE_USERNAME=medicare_user
DATABASE_PASSWORD=CHANGE_ME
DATABASE_SSL=false
OPENAI_API_KEY=sk-...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NODE_ENV=production

PUBLIC_URL=https://medicare.fly.dev

# ── Firebase Cloud Messaging (push notifications) ──────────────────
# Paste the entire service account JSON as a single-line string.
# Get it from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_SERVICE_ACCOUNT=

# ── Assistant IA (Sprint 15) — compatible OpenAI / Groq / Gemini ───
# Option gratuite recommandée : Groq (https://console.groq.com)
# Voir docs/AI_SETUP.md pour le détail des fournisseurs.
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
