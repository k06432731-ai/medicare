{
  "kind": "collectionType",
  "collectionName": "payments",
  "info": {
    "singularName": "payment",
    "pluralName": "payments",
    "displayName": "Payment"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "invoiceId":     { "type": "integer", "required": true },
    "patientId":     { "type": "integer", "required": true },
    "amount":        { "type": "decimal", "required": true },
    "method":        {
      "type": "enumeration",
      "enum": ["sobflous", "d17", "cash", "bank_transfer", "mobile_money", "card", "konnect"],
      "required": true
    },
    "status":        {
      "type": "enumeration",
      "enum": ["pending", "processing", "completed", "failed"],
      "default": "pending"
    },
    "transactionId": { "type": "string" },
    "paymentUrl":    { "type": "text" },
    "callbackData":  { "type": "json" }
  }
}
