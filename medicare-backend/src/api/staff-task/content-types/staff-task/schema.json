{
  "kind": "collectionType",
  "collectionName": "staff_tasks",
  "info": {
    "singularName": "staff-task",
    "pluralName": "staff-tasks",
    "displayName": "Staff Task",
    "description": "Human task generated when automated recovery fails"
  },
  "options": { "draftAndPublish": false },
  "attributes": {
    "recoveryCaseId": {
      "type": "integer",
      "required": true
    },
    "patientName": {
      "type": "string",
      "required": true
    },
    "patientPhone": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["pending", "inProgress", "done", "cancelled"],
      "default": "pending",
      "required": true
    },
    "priority": {
      "type": "enumeration",
      "enum": ["low", "medium", "high", "critical"],
      "default": "medium",
      "required": true
    },
    "dueDate": {
      "type": "datetime",
      "required": true
    },
    "completedAt": {
      "type": "datetime"
    },
    "assignedToId": {
      "type": "integer"
    },
    "caseType": {
      "type": "string"
    }
  }
}
